++
++  const save = () => {
++    if (!draft.trim()) return;
++    setApiToken(draft);
++    setStored(getApiToken());
++    setDraft("");
++    // The saved token changes every request's auth: refetch everything once.
++    void queryClient.invalidateQueries();
++  };
++
++  const clear = () => {
++    clearApiToken();
++    setStored(null);
++    setDraft("");
