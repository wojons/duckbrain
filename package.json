{
  "name": "duckbrain",
  "version": "1.1.0",
  "packageManager": "pnpm@12.4.2",
  "description": "AI Memory System - MCP server with persistent, version-controlled memory",
  "main": "index.js",
  "bin": {
    "duckbrain": "./bin/duckbrain.js"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/",
    "test:http": "vitest run --config vitest.integration.config.ts tests/http-auth.int.test.ts tests/http-e2e.int.test.ts tests/http-ratelimit.int.test.ts",
    "test:mutation": "bash scripts/red-proof-gate.sh",
    "test:mutation:stryker": "stryker run",
    "build:cli": "tsc -p tsconfig.build.json",
    "start": "node bin/duckbrain.js",
    "start:http": "node bin/duckbrain.js http --port 3000",
    "dev:api": "node bin/duckbrain.js http --port 3000 --auth=none",
    "start:ui": "node scripts/start-ui.mjs",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm start:ui\"",
    "dev:docker": "docker-compose -f docker-compose.dev.yml up",
    "build": "pnpm --dir packages/ui build",
    "docker:build": "docker build -t duckbrain .",
    "docker:run": "docker run -p 3000:3000 -p 5173:5173 -v duckbrain-data:/data duckbrain",
    "stop": "node scripts/scoped-stop.js",
    "ops:check": "node scripts/check-no-pattern-kill.js",
    "ops:embedding-preflight": "node scripts/embedding-preflight.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wojons/duckbrain.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wojons/duckbrain/issues"
  },
  "homepage": "https://github.com/wojons/duckbrain#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@smithy/node-http-handler": "4.12.1",
    "async-mutex": "^0.5.0",
    "bcryptjs": "^3.0.3",
    "duckdb": "1.4.4",
    "express": "^5.3.0",
    "simple-git": "^4.0.2",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
