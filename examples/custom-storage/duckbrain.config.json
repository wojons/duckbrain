{
  "defaultNamespace": "personal",
  "authorEmail": "you@example.com",
  "storage": {
    "maxLinesPerChunk": 2000,
    "maxBytesPerChunk": 2097152
  },
  "durability": {
    "defaultMode": "fsync",
    "overrides": {
      "bulk-import": "buffered"
    }
  },
  "gitBatching": {
    "maxLines": 250,
    "maxSeconds": 60,
    "enabled": true
  },
  "squash": {
    "maxAgeDays": 14,
    "thresholdRecords": 5000,
    "autoCompact": true,
    "squashGitHistory": true,
    "compressionLevel": 6
  },
  "realtime": {
    "enabled": true,
    "pollIntervalMs": 1000,
    "heartbeatMs": 15000
  }
}
