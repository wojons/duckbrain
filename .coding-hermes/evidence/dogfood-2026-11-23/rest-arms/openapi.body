n applies.","schema":{"type":"string"}}],"responses":{"200":{"description":"The latest non-tombstoned memory for the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MemoryResponse"}}}},"403":{"description":"The caller is not authorized for this memory namespace.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"No memory exists for the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"500":{"description":"The memory lookup failed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/memories/{id}":{"get":{"operationId":"getMemory","summary":"Get one memory by id","parameters":[{"name":"id","in":"path","required":true,"description":"Memory id (UUID).","schema":{"type":"string","format":"uuid"}},{"name":"namespace","in":"query","required":false,"description":"Namespace to query or write. If omitted, the existing active/default namespace resolution applies.","schema":{"type":"string"}}],"responses":{"200":{"description":"The memory.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MemoryResponse"}}}},"403":{"description":"The caller is not authorized for this memory namespace.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"No memory exists for the id.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"500":{"description":"The memory lookup failed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}},"put":{"operationId":"updateMemory","summary":"Update a memory (new version; the previous version stays in the ledger)","parameters":[{"name":"id","in":"path","required":true,"description":"Memory id (UUID).","schema":{"type":"string","format":"uuid"}},{"name":"namespace","in":"query","required":false,"description":"Namespace to query or write. If omitted, the e