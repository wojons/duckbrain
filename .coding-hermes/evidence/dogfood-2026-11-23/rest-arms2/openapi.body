se"}}}},"400":{"description":"The request body is invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"403":{"description":"The caller is not authorized for this memory namespace.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"The target namespace does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"500":{"description":"The memory could not be created.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/memories/key/{key}":{"get":{"operationId":"getMemoryByKey","summary":"Get the latest memory by key","parameters":[{"name":"key","in":"path","required":true,"description":"Filesystem-style memory key without the leading slash; slash-separated segments are accepted.","schema":{"type":"string"}},{"name":"namespace","in":"query","required":false,"description":"Namespace to query or write. If omitted, the existing active/default namespace resolution applies.","schema":{"type":"string"}}],"responses":{"200":{"description":"The latest non-tombstoned memory for the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MemoryResponse"}}}},"403":{"description":"The caller is not authorized for this memory namespace.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"No memory exists for the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"500":{"description":"The memory lookup failed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/memories/{id}":{"get":{"operationId":"getMemory","summary":"Get one memory by id","parameters":[{"name":"id","in":"path","required":true,"description":"Memory id (UUID).","schema":{"type":"string","format":"uuid"}},{"name":"namespace","in":"query","required":false,"description":"Namespace to query