{"openapi":"3.1.0","info":{"title":"DuckBrain tables — namespace 'tables_df_20261123'","version":"1.1.0","description":"Generated from the declared table registry (namespaces/<ns>/tables/*.table.json). PostgREST-style filters/order/paging on every table. This namespace document also describes the global memory routes; those routes retain their existing namespace query/body behavior."},"paths":{"/api/ns/tables_df_20261123/tables/events":{"get":{"operationId":"list_events","summary":"Select rows from 'events'","parameters":[{"name":"id","in":"query","description":"Filter by id. PostgREST conventions: eq|ne|neq|gt|gte|lt|lte|like|ilike|in|is|isdistinct|fts|plfts, any of them negated with the not. prefix (e.g. ?id=eq.5, ?id=not.is.null, ?id=fts.alpha,beta). The full 25-operator coverage table is in docs/api/http-api.md.","required":false,"schema":{"type":"string"}},{"name":"name","in":"query","description":"Filter by name. PostgREST conventions: eq|ne|neq|gt|gte|lt|lte|like|ilike|in|is|isdistinct|fts|plfts, any of them negated with the not. prefix (e.g. ?name=eq.5, ?name=not.is.null, ?name=fts.alpha,beta). The full 25-operator coverage table is in docs/api/http-api.md.","required":false,"schema":{"type":"string"}},{"name":"qty","in":"query","description":"Filter by qty. PostgREST conventions: eq|ne|neq|gt|gte|lt|lte|like|ilike|in|is|isdistinct|fts|plfts, any of them negated with the not. prefix (e.g. ?qty=eq.5, ?qty=not.is.null, ?qty=fts.alpha,beta). The full 25-operator coverage table is in docs/api/http-api.md.","required":false,"schema":{"type":"string"}},{"name":"active","in":"query","description":"Filter by active. PostgREST conventions: eq|ne|neq|gt|gte|lt|lte|like|ilike|in|is|isdistinct|fts|plfts, any of them negated with the not. prefix (e.g. ?active=eq.5, ?active=not.is.null, ?active=fts.alpha,beta). The full 25-operator coverage table is in docs/api/http-api.md.","required":false,"schema":{"type":"string"}},{"name":"meta","in":"query","description":"Filter by meta. PostgREST conventions: eq|ne|neq|gt|gte|lt|lte|like|ilike|in|is|isdistinct|fts|plfts, any of them negated with the not. prefix (e.g. ?meta=eq.5, ?meta=not.is.null, ?meta=fts.alpha,beta). The full 25-operator coverage table is in docs/api/http-api.md.","required":false,"schema":{"type":"string"}},{"name":"select","in":"query","description":"Projection: comma-separated declared columns; `*` selects all columns and `relation(*)` embeds a declared relation.","required":false,"schema":{"type":"string"}},{"name":"order","in":"query","description":"Ordering: comma-separated col.asc / col.desc list (e.g. order=qty.desc,name.asc).","required":false,"schema":{"type":"string"}},{"name":"limit","in":"query","description":"Row limit (default 100, hard cap 1000 — larger values clamp).","required":false,"schema":{"type":"integer","default":100,"maximum":1000}},{"name":"offset","in":"query","description":"Row offset for paging.","required":false,"schema":{"type":"integer","minimum":0}},{"name":"count","in":"query","description":"`exact` | `planned` | `estimated` — asks for the total row count. The total is reported as the `Content-Range` denominator and in `X-Total-Count`. `planned` and `estimated` are served as the EXACT count: a JSONL table scan has no planner estimate to report, and an exact total is a superset of the number those modes ask for (see docs/api/http-api.md).","required":false,"schema":{"type":"string","enum":["exact","planned","estimated"]}},{"name":"Range","in":"header","description":"Inclusive row window for paging — exactly what postgrest-js `.range(from, to)` sends. `Range: 0-9` returns rows 0..9 and translates to `offset=0&limit=10`; it outranks `limit`/`offset` when both are present, and the 1000-row cap still clamps. An open-ended `Range: 10-` reads one page from row 10. A malformed window is 400 VALIDATION_ERROR.","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Rows (JSON array, or CSV with Accept: text/csv)","headers":{"Content-Range":{"description":"The row window served: `<first>-<last>/<total|*>`, or `*/<total|*>` when the window is past the end of the result (the body is then `[]`). The denominator is the exact total when `count` was requested, `*` otherwise.","schema":{"type":"string"}},"X-Total-Count":{"description":"Exact number of matching rows before limit/offset. Present when the request asked for a count (`Prefer: count=*` or `?count=*`).","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"type":"array","items":{"type":"object","properties":{"id":{"type":"number","format":"double"},"name":{"type":"string"},"qty":{"type":"number","format":"double"},"active":{"type":"boolean"},"meta":{}},"required":["id","name","qty","active","meta"]}}},"text/csv":{"schema":{"type":"string"}}}}}},"post":{"operationId":"insert_events","summary":"Insert row(s) into 'events'","requestBody":{"required":true,"content":{"application/json":{"schema":{"oneOf":[{"type":"object","properties":{"id":{"type":"number","format":"double"},"name":{"type":"string"},"qty":{"type":"number","format":"double"},"active":{"type":"boolean"},"meta":{}},"required":["id","name","qty","active","meta"]},{"type":"array","items":{"type":"object","properties":{"id":{"type":"number","format":"double"},"name":{"type":"string"},"qty":{"type":"number","format":"double"},"active":{"type":"boolean"},"meta":{}},"required":["id","name","qty","active","meta"]}}]}},"application/x-ndjson":{"schema":{"type":"string"}}}},"responses":{"201":{"description":"Inserted","content":{"application/json":{"schema":{"type":"object","properties":{"inserted":{"type":"integer"}}}}}}}},"patch":{"operationId":"update_events","summary":"Update rows of 'events' by primary key","parameters":[{"name":"pk","in":"query","description":"Required. Primary key equality filter: pk=eq.<value> on 'id'.","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"number","format":"double"},"name":{"type":"string"},"qty":{"type":"number","format":"double"},"active":{"type":"boolean"},"meta":{}},"required":["id","name","qty","active","meta"]}}}},"responses":{"200":{"description":"Updated (rows mutated)"}}},"delete":{"operationId":"delete_events","summary":"Delete rows of 'events' by primary key","parameters":[{"name":"pk","in":"query","description":"Required. Primary key equality filter: pk=eq.<value> on 'id'.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Deleted (rows removed)"}}}},"/api/ns/tables_df_20261123/tables/events/{pk}":{"put":{"operationId":"upsert_events","summary":"Insert or replace one row of 'events' by primary key","parameters":[{"name":"pk","in":"path","required":true,"description":"Primary key value on 'id'.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"number","format":"double"},"name":{"type":"string"},"qty":{"type":"number","format":"double"},"active":{"type":"boolean"},"meta":{}},"required":["id","name","qty","active","meta"]}}}},"responses":{"200":{"description":"Replaced (outcome: updated, body carries the row)"},"201":{"description":"Inserted (outcome: inserted, body carries the row)"},"409":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/ns/tables_df_20261123/tables/_transaction":{"post":{"operationId":"run_table_transaction","summary":"Apply an ordered list of table mutations as ONE unit (all-or-nothing)","description":"Every action is validated before anything is written. The envelope takes one durability barrier at commit and appends one change record per action. On failure nothing is applied: the response carries `applied: 0`, `rolledBack: true` and `failedAction`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["actions"],"properties":{"actions":{"type":"array","minItems":1,"items":{"type":"object","required":["op","table"],"properties":{"op":{"type":"string","enum":["insert","update","upsert","delete"]},"table":{"type":"string"},"row":{"type":"object","additionalProperties":true},"patch":{"type":"object","additionalProperties":true},"pk":{"type":"string"}}}}}}}}},"responses":{"200":{"description":"Applied — `applied`, `results[]` and the achieved durability"},"409":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"413":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/ns/tables_df_20261123/tables":{"get":{"operationId":"list_tables","summary":"List the tables DECLARED in this namespace","description":"Registry metadata only (name, format, columns, primary, source) — no rows. Namespace-granted: the grant model has no wildcard table name.","responses":{"200":{"description":"The namespace and its declared tables.","content":{"application/json":{"schema":{"type":"object","required":["namespace","tables"],"properties":{"namespace":{"type":"string"},"tables":{"type":"array","items":{"$ref":"#/components/schemas/TableDeclaration"}}}}}}},"403":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"Refused","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/api/ns/tables_df_20261123/tables/{table}/declare":{"post":{"operationId":"declare_table","summary":"Create or replace a table declaration","description":"Writes through the SAME core the CLI (`duckbrain tables declare`) and the MCP `tables_declare` tool call. 201 when the declaration is new, 200 when an identical contract already existed or `force` replaced it.","parameters":[{"name":"table","in":"path","required":true,"description":"Table name (must match /^[a-z0-9_-]+$/).","schema":{"type":"string