# DuckBrain Environment Configuration
# Copy this file to .env and customize for your setup

# =============================================================================
# Required Configuration
# =============================================================================

# Project namespace for memory isolation
# Each namespace gets its own git repository
DUCKBRAIN_NAMESPACE=default

# =============================================================================
# Optional Configuration
# =============================================================================

# Data directory for memory storage
# Default: ./memory (relative to working directory)
DUCKBRAIN_DATA_DIR=./memory

# API Server Configuration
DUCKBRAIN_API_PORT=3000
DUCKBRAIN_API_HOST=localhost

# Web UI Configuration  
DUCKBRAIN_UI_PORT=8989

# Git Configuration
DUCKBRAIN_GIT_REMOTE=origin

# Logging
# Options: debug, info, warn, error
DUCKBRAIN_LOG_LEVEL=info

# =============================================================================
# Development Settings
# =============================================================================

# Node environment
NODE_ENV=development

# =============================================================================
# Security (for HTTP mode)
# =============================================================================

# API Authentication Token (generate with: openssl rand -base64 32)
# DUCKBRAIN_API_TOKEN=your-secure-token-here

# Rate Limiting
# DUCKBRAIN_RATE_LIMIT_ENABLED=true
# DUCKBRAIN_RATE_LIMIT_MAX=100

# =============================================================================
# Embeddings (semantic search)
# =============================================================================
# Provider: auto (probe lmstudio -> ollama -> openai) | lmstudio | ollama | openai
# DUCKBRAIN_EMBEDDING_PROVIDER=auto

# Model id passed to the provider. Default text-embedding-qwen3-embedding-0.6b
# is deployed in ollama as a cp-alias of qwen3-embedding:0.6b (see
# docs/guide/embeddings.md — never rename the id, it keys the .embeddings cache).
# DUCKBRAIN_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b

# Provider base URL override (lmstudio http://localhost:1234/v1, ollama
# http://localhost:11434, openai https://api.openai.com/v1)
# DUCKBRAIN_EMBEDDING_BASE_URL=

# API key for remote providers (required for openai)
# DUCKBRAIN_EMBEDDING_API_KEY=

# Vector dimensions (metadata only — cache.ts stores vector.length)
# DUCKBRAIN_EMBEDDING_DIMENSIONS=384

# Per-embed HTTP timeout in ms (default 10000)
# DUCKBRAIN_EMBEDDING_TIMEOUT_MS=10000

