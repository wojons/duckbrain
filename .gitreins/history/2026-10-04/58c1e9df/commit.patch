+    super(
+      `[S3] ${ns} exceeded its ${Math.round(timeoutMs / 1000)}s deadline after ${done}/${total} files (partial progress saved; sync abandoned)`,
+    );
+    this.name = "NamespaceSyncDeadlineError";
+  }
+}
