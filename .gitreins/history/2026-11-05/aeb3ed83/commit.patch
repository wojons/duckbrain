+  line("");
+  line(failures === 0 ? "RESULT: PASS — every step above was served by DuckBrain." : `RESULT: FAIL — ${failures} assertion(s) failed.`);
+  process.exit(failures === 0 ? 0 : 1);
+}
+
+main().catch((error) => {
+  line(`ABORTED: ${error?.stack ?? error}`);
+  process.exit(1);
+});
