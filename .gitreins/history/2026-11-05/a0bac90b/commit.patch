+    entry = acceptedTableMutationRecord({
+      ns,
+      namespacePath: namespaceDir(ns),
+      table,
+      op,
+      principal,
+      targetPath: location.targetPath,
+      dataLine: location.dataLine,
+      row: location.row,
+    });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    throw new ApiError(
