+  SCHEMA_FILE_NAME,
+  invalidateNamespaceSchema,
+  loadNamespaceSchema,
+} from "../serialization/schemaRegistry.js";
+import {
+  COLUMN_NAME_PATTERN,
+  RESOURCE_NAME_PATTERN,
+  isReservedResourceName,
+  type DeclaredColumn,
+  type DeclaredColumnType,
+  type RowShape,
+} from "../serialization/schemaTypes.js";
+import {
+  TABLE_COLUMN_TYPES,
+  TABLE_FORMATS,
+  invalidateTableRegistry,
+  listTables,
+  type TableFormat,
