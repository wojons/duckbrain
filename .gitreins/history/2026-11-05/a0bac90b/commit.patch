+import fs from "fs";
+import path from "path";
+import { resolveNamespacesPath } from "../config/index.js";
+import { releaseNamespaceWriteLock } from "../serialization/lock.js";
+import {
+  DDL_DIR,
+  acquireDdlFence,
+  writeSchemaTextAtomic,
+} from "../serialization/ddl.js";
