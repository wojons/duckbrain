+
+  it("reports isOrphaned for both reparenting targets", () => {
+    expect(isOrphaned(proc({ pid: 1, ppid: 1, cmdline: SCRATCH_CMDLINE }))).toBe(true);
+    expect(
+      isOrphaned(
