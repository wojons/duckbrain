+    const { victims, spared } = planDaemonReap([self, ownGroup], {
+      ownTree: [process.pid],
+      ownPgrp: 7777,
+    });
+    expect(victims).toEqual([]);
+    expect(spared.map((s) => s.reason)).toEqual([
+      "own process tree",
+      "own process group",
+    ]);
