    test(red-proof): add working mutation enforcement gate to CI (TESTQ-001)
    
    Co-authored-by: Alexis Okuwa <wojonstech@gmail.com>
---
 scripts/red-proof-gate.sh | 50 +++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 42 insertions(+), 8 deletions(-)

diff --git a/scripts/red-proof-gate.sh b/scripts/red-proof-gate.sh
index 6c8a68a..a835752 100755
--- a/scripts/red-proof-gate.sh
+++ b/scripts/red-proof-gate.sh
@@ -17,20 +17,54 @@ if [ ! -f "$PROD" ]; then
     exit 1
 fi
 
-ORIGINAL=$(cat "$PROD")
+# Save original and apply mutation using Python for precision
+cp "$PROD" /tmp/de-backup.ts
+python3 << 'PYEOF'
+import sys
+with open("/home/kara/duckbrain/src/storage/durability-errors.ts") as f:
+    content = f.read()
 
-# Mutation: replace the instanceof check with `return false`
-sed -i 's/return target instanceof DurabilityError/return false/g' "$PROD"
+old_func = """export function isDurabilityError(error: unknown): error is DurabilityError {
+  return (
+    error instanceof DurabilityError ||
+    (typeof error === "object" &&
+      error !== null &&
+      (error as { name?: string }).name === "DurabilityError" &&
+      typeof (error as { code?: string }).code === "string")
+  );
+}"""
+
+new_func = """export function isDurabilityError(error: unknown): error is DurabilityError {
+  return false;
+}"""
+
+if old_func in content:
+    content = content.replace(old_func, new_func, 1)
+    with open("/home/kara/duckbrain/src/storage/durability-errors.ts", "w") as f:
+        f.write(content)
+    print("MUTATION applied successfully")
+else:
+    print("ERROR: could not find function to mutate")
+    sys.exit(1)
+PYEOF
 
-echo "Red-proof gate: testing that tests FAIL when instanceof check is removed"
 cd "$REPO_ROOT"
 
+echo "Red-proof gate: MUTATING isDurabilityError → return false"
+echo ""
+
 if npx vitest run "$TEST_FILE" 2>&1; then
-    echo "FAIL: tests passed on broken code — phantom suite detected"
-    echo "$ORIGINAL" > "$PROD"
+    echo ""
+    echo "FAIL: Red-proof gate FAILED."
+    echo "  Tests PASSED even after production code was broken."
+    echo "  This means the tests are PHANTOMS."
+    cp /tmp/de-backup.ts "$PROD"
     exit 1
 else
-    echo "$ORIGINAL" > "$PROD"
-    echo "PASS: tests correctly failed on broken code — suite is red-proof"
+    echo ""
+    echo "PASS: Red-proof gate works correctly."
+    echo "  Tests correctly FAIL when isDurabilityError is broken."
+    echo "  The suite is red-proof — it catches production code breakage."
+    cp /tmp/de-backup.ts "$PROD"
     exit 0
 fi
