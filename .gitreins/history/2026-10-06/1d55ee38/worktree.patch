+/** The baseline assertion set under proof: how a correct isDurabilityError must behave. */
+function baselineAssertions(isErr: (error: unknown) => boolean): void {
+  expect(isErr(new DurabilityError("DURABILITY_BYPASS", "x"))).toBe(true);
+  expect(isErr({ name: "DurabilityError", code: "DURABILITY_FSYNC_FAILED" })).toBe(true);
+  expect(isErr(null)).toBe(false);
+  expect(isErr(undefined)).toBe(false);
+  expect(isErr("string error")).toBe(false);
+  expect(isErr(new Error("connection reset"))).toBe(false);
+  expect(isErr(new TypeError("bad type"))).toBe(false);
+}
