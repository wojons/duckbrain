+// INT-CI-028: the byte-identity assert below (GAP-022 AC1) compares the REAL
+// repo config against itself across this suite's lifetime. When the full
+// vitest suite runs in parallel, a sibling suite (namespace auto-create) can
+// legitimately append a mapping to the real config in that window, failing
+// this suite with a 15k-line config diff (guard c9090ebf, auger-pytest-5eb8…).
+// Fix: redirect DUCKBRAIN_CONFIG_PATH (the GAP-022 override) to a temp copy of
+// the repo config for this suite's duration, so AC1 guards THIS suite's own
+// writes against an isolated snapshot while siblings write to the real file.
+let configRedirect: string | null = null;
+
 function readRepoConfig(): string | null {
   // The instance config is untracked (gitignored; see
   // duckbrain.config.example.json) — a fresh clone has none. Missing = null;
@@ -101,6 +112,16 @@ describe("GAP-024: pagination response correctness — GET /api/memories", () =>
     // GAP-022 AC1: the repo config file must be byte-identical after the run
     configBefore = readRepoConfig();
 
+    // INT-CI-028: isolate this suite's config view from sibling suites.
+    if (fs.existsSync(REPO_CONFIG)) {
+      const configDir = fs.mkdtempSync(
+        path.join(os.tmpdir(), "gap024-config-"),
+      );
+      configRedirect = path.join(configDir, "duckbrain.config.json");
+      fs.copyFileSync(REPO_CONFIG, configRedirect);
+      process.env.DUCKBRAIN_CONFIG_PATH = configRedirect;
+    }
+
     // Seed a real namespace: JSONL partition + manifest (dogfood002 pattern)
     fs.mkdirSync(PARTITION, { recursive: true });
     const lines: string[] = [];
@@ -132,10 +153,18 @@ describe("GAP-024: pagination response correctness — GET /api/memories", () =>
 
