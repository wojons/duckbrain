[Unit]
Description=DuckBrain HTTP MCP daemon (auto-restart hardened, OPS-001)
After=network.target

[Service]
Type=simple
ExecStart=node %h/duckbrain/bin/duckbrain.js http --port=3000
WorkingDirectory=%h/duckbrain
# OPS-001: a graceful SIGTERM exits 0, which on-failure restart policies
# treat as success and leave the daemon dark. Restart=always covers BOTH
# crash exits and graceful stops.
Restart=always
RestartSec=3
# Start-limit: allow a burst of restarts, then cool down instead of giving
# up (StartLimitAction=default = the unit enters failed state, which monitoring
# should alert on alongside the dark-port check).
StartLimitIntervalSec=300
StartLimitBurst=10
# Graceful stop: SIGTERM, then SIGKILL after the grace window. Matches the
# daemon's graceful shutdown (durability drain + commit flush) plus headroom.
KillSignal=SIGTERM
TimeoutStopSec=30
# OPS-014: the 2026-11-14 SEGV reached a 4G RSS peak against a 4G MemoryHigh
# and a 9G swap peak. Keep the learned memory discipline in the deploy asset.
MemoryHigh=6442450944
MemoryMax=8589934592
Environment=NODE_ENV=production
# V8 diagnostic reports are retained beside the crash evidence bundle.
Environment="NODE_OPTIONS=--max-old-space-size=3072 --report-on-fatalerror --report-directory=%h/.local/state/duckbrain/crash-evidence --report-compact"
# Capture non-clean exits; '-' makes evidence collection best effort.
ExecStopPost=-node %h/duckbrain/scripts/crash-attribution.js

[Install]
WantedBy=default.target
